# =============================================================================
# Transcription Connector Configuration (Local Clinic ASR)
# =============================================================================
# Speakr clinic fork supports local-only automatic speech recognition:
# 1. Speaches / OpenAI-compatible local ASR: openai_whisper connector with custom TRANSCRIPTION_BASE_URL
# 2. Self-hosted Whisper / WhisperX: asr_endpoint connector with ASR_BASE_URL
# 3. Offline synthetic testing: clinic_stub connector
#
# All hosted/cloud ASR connectors (OpenAI GPT-4o Transcribe, Azure OpenAI,
# Mistral, Tencent, Alibaba FunASR, Mossland, AssemblyAI, VibeVoice, OpenASR)
# have been removed.

# =============================================================================
# TEXT GENERATION MODEL (REQUIRED for summaries, titles, chat)
# =============================================================================
# Speakr uses a text/LLM model for generating summaries, titles, and chat.
# This is separate from the transcription model (STT).

TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL_API_KEY=your_openrouter_api_key
TEXT_MODEL_NAME=openai/gpt-4o-mini

# =============================================================================
# CONNECTOR SELECTION (Auto-detected if not set)
# =============================================================================
# Options: openai_whisper, asr_endpoint, clinic_stub
# Leave empty to auto-detect based on other settings
# TRANSCRIPTION_CONNECTOR=

# =============================================================================
# OPENAI-COMPATIBLE LOCAL ASR (Speaches / LocalAI / Whisper-compatible)
# =============================================================================
# Used when TRANSCRIPTION_CONNECTOR=openai_whisper (or default when ASR_BASE_URL is unset)
# In CLINIC_MODE, TRANSCRIPTION_BASE_URL must point to a local/private address
# (loopback, RFC1918, ULA, or single-label container name such as 'speaches').
TRANSCRIPTION_API_KEY=not-needed-for-local
TRANSCRIPTION_BASE_URL=http://speaches:8000/v1
TRANSCRIPTION_MODEL=Systran/faster-distil-whisper-large-v3
# Request timeout (seconds, > 0) and SDK retries (integer >= 0) for this connector.
# Unset: the OpenAI SDK defaults apply (600 s, 2 retries). With CLINIC_MODE on the
# defaults are 3600 s and 0 retries, so a long CPU transcription is not aborted and
# re-sent while the ASR server is still working on it. An invalid value is a
# configuration error. The GPU target (CLINIC_GPU_ASR_TIMEOUT) keeps its own, shorter timeout.
# TRANSCRIPTION_TIMEOUT=3600
# TRANSCRIPTION_MAX_RETRIES=0

# Comma-separated list of transcription model names offered in the per-upload
# model dropdown. Leave empty to hide the dropdown.
# TRANSCRIPTION_MODELS_AVAILABLE=

# =============================================================================
# ASR ENDPOINT CONFIGURATION (For self-hosted whisper services)
# =============================================================================
# The connector will auto-detect ASR mode when ASR_BASE_URL is set.
# Supports: whisper-asr-webservice, WhisperX, and compatible services
# ASR_BASE_URL=http://whisper-asr:9000

# Request timeout in seconds (default: 1800 = 30 minutes)
# ASR_TIMEOUT=1800

# Enable speaker diarization (default: true)
# ASR_DIARIZE=true

# Speaker count hints (optional, helps with diarization accuracy)
# ASR_MIN_SPEAKERS=1
# ASR_MAX_SPEAKERS=5

# Return speaker embeddings for speaker identification (WhisperX)
# ASR_RETURN_SPEAKER_EMBEDDINGS=false

# Asynchronous jobs of the WhisperX ASR service: used when the service
# advertises them in /health.
# Default: true
# ASR_ASYNC_JOBS=true

# =============================================================================
# CHUNKING CONFIGURATION (For large files)
# =============================================================================
# Chunking is connector-aware:
# - asr_endpoint: Handled internally, chunking settings ignored
# - openai_whisper: Uses these settings for files >25MB
#
# ENABLE_CHUNKING=false  # Uncomment to disable chunking for openai_whisper
CHUNK_LIMIT=20MB
CHUNK_OVERLAP_SECONDS=3

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Video passthrough (send raw video to ASR, for custom backends)
# VIDEO_PASSTHROUGH_ASR=false

# =============================================================================
# DICTATION FILES (.ds2 / .dss)
# =============================================================================
# Path of the pinned dss-decode binary (dss-codec, upstream commit c38d3192...).
# The Docker image builds it, verifies its SHA-256 and sets this variable to
# /usr/local/bin/dss-decode. Outside Docker, set it yourself. Without it an
# uploaded .ds2/.dss is stored but its recording ends FAILED with a message
# that the decoder is not set up; there is no fallback.
CLINIC_DSS_CODEC_BIN=/usr/local/bin/dss-decode
