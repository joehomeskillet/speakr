<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Speakr.Clinic.ImportAgent.Worker</RootNamespace>
  </PropertyGroup>
  <!-- The published Windows worker includes its small configuration dialog.
       The headless core and its tests also build on non-Windows hosts. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(RuntimeIdentifier)' == 'win-x64'">
    <DefineConstants>$(DefineConstants);IMPORT_WINDOWS_DIALOG</DefineConstants>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(RuntimeIdentifier)' == 'win-x64'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Speakr.Clinic.ImportAgent.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Speakr.Clinic.ImportAgent\Speakr.Clinic.ImportAgent.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.4" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
