# Existing upstream flags; NOT a complete deployment or implementation.
# Local-first. New clinical controls in auth.local.example.json require code.
# Never put real credentials in this file; LOCAL_SECRET below is an invalid placeholder.
SQLALCHEMY_DATABASE_URI=postgresql://speakr:LOCAL_SECRET@suedhang-db:5432/speakr
ENABLE_INTERNAL_SHARING=false
ENABLE_PUBLIC_SHARING=false
ENABLE_AUTO_DELETION=false
ENABLE_INQUIRE_MODE=false
ENABLE_SERVER_RECORDING_CHUNKS=true
ENABLE_SSO=false
SSO_AUTO_REGISTER=false
SSO_DISABLE_PASSWORD_LOGIN=false
SSO_REQUIRE_VERIFIED_EMAIL=true
# No SSO client/discovery/secret required in local mode.
# Enforce self-registration=false and per-account login policy in clinical code.
# Reuse local auth/admin UI. Disable email-autolinking and generic admin fallback.
# Do not simply flip these flags to declare the clinical auth implementation complete.
