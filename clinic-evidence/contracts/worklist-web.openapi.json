      {"source": "clinic-api", "method": "GET", "path": "/api/clinic/v1/dictations", "operationId": "listDictations", "schema": "DictationList", "handler": "src.clinic.worklist_filters.query_worklist"},
      {"source": "clinic-api", "method": "GET", "path": "/api/clinic/v1/dictations/{dictation_id}", "operationId": "getDictation", "schema": "Dictation", "handler": "src.clinic.policy.decide"},
