{
  "openapi": "3.1.0",
  "info": {
    "title": "Speakr clinic web worklist extensions (additive proposal)",
    "version": "0.1.0-proposal",
    "description": "New own-platform Speakr extension contracts, gated by CLINIC_MODE. These operations are proposed HTTP adapters over existing clinic services, not registered endpoints or manufacturer interfaces. Manufacturer integration remains unresolved. No external API behavior is assumed; BT-CFG-002 and BT-WF-001 remain unexecuted. All responses are private with Cache-Control: no-store."
  },
  "servers": [{"url": "/"}],
  "security": [{"browserSession": []}],
  "x-parity-ids": ["PAR-WF-001", "PAR-CFG-002"],
  "x-reused-operations": {
