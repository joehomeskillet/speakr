      {"source": "clinic-api", "method": "POST", "path": "/api/clinic/v1/dictations/{dictation_id}/releases", "operationId": "releaseVersion", "schema": "ReleaseRequest", "handler": "src.clinic.release.create_release"},
      {"source": "parity-api", "method": "POST", "path": "/parity/commands", "operationId": "executeParityCommand", "commandId": "request_acceptance", "schema": "RequestAcceptance", "handler": "src.clinic.acceptance_rules.can_decide"},
      {"source": "parity-api", "method": "POST", "path": "/parity/commands", "operationId": "executeParityCommand", "commandId": "decide_acceptance", "schema": "DecideAcceptance", "handler": "src.clinic.acceptance_rules.decide"},
      {"source": "parity-api", "method": "POST", "path": "/parity/commands", "operationId": "executeParityCommand", "commandId": "reopen_dictation", "schema": "ReopenDictation", "handler": "src.clinic.workflow.transition"}
    ],
    "history-api": [
      {"source": "clinic-api", "method": "GET", "path": "/api/clinic/v1/dictations/{dictation_id}/revisions/{revision_id}", "operationId": "getRevisionContent", "schema": "TranscriptContent", "handler": "src.clinic.revisions.history"},
      {"source": "clinic-api", "method": "POST", "path": "/api/clinic/v1/dictations/{dictation_id}/revisions", "operationId": "saveRevision", "schema": "SaveRevision", "handler": "src.clinic.revisions.add_human_revision"}
    ],
    "templates-api": [],
    "categories-api": [],
    "regex-api": [],
    "columns-api": []
  },
  "x-reuse-note": "Existing operationIds and parity commands above remain owned by their source specifications. Handler values identify reusable Python service entry points, not registered HTTP handlers. The parity save_filter payload requires translation into the existing filter specification. getRevisionContent selects the requested revision by id from authorized history; current_revision returns only the head. On every saveRevision, automatic text/audio synchronization preserves unchanged word timestamps, assigns changed spans neighboring timestamps and leaves newly typed words unanchored. HTTP adapters must enforce policy, open review markers and leases before calling services. No new operation replaces an existing method/path.",
  "x-write-policy": "All writes require an authenticated browser session, valid X-CSRFToken, Idempotency-Key UUID and strong If-Match revision tag. Creation uses If-Match: \"0\" for an absent scope/name resource. Compare the current object or scope revision in the same atomic transaction as the change and immutable audit. Missing precondition 428; stale 412; same actor+operation+object+key and identical request hash replays the original status/body; altered payload 409; ambiguous failure must be reconciled before retrying. Permission and current action-specific denies are checked on every request, including replays. 401 unauthenticated, 403 forbidden, 404 hidden objects, 422 unsupported capability, 503 local dependency failure with no fabricated success.",
  "x-read-policy": "Authenticate and authorize per object and per action before projection, filtering, pagination or count. Active administrators may directly read any user's dictation, transcript and audio, with access auditing and no reason prompt. Unassigned dictations are visible only to administrators and the relevant typist-pool leads; those roles may assign to any author with audit. Ordinary typists see only their assignments; authors see their permitted own work. This is target behavior: current policy.decide does not grant access from is_admin alone and workflow.worklist currently includes unassigned cases for ordinary typists. HTTP adapters require explicit role checks and audit before exposing these views; service changes belong to their implementation packages.",
  "paths": {
