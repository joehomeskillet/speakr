      "get": {
        "operationId": "listClinicTemplates", "tags": ["templates-api"], "x-handler": "src.clinic.presets.list_templates", "summary": "Berechtigte serverseitige Vorlagen",
        "description": "System, own user and authorized pool scopes only; metadata without source paths or file bytes.",
        "responses": {"200": {"description": "Bounded template catalog", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/TemplateSummary"}}}, "required": ["items"]}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}}
