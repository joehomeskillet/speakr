        "responses": {"200": {"description": "Stored DOCX or ODT, <= 2 MiB", "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary", "maxLength": 2097152}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}}
