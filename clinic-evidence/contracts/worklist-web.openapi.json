      "get": {
        "operationId": "getWorklistRows", "tags": ["worklist-api"], "x-handler": "src.clinic.worklist_filters.query_worklist", "summary": "Berechtigte Arbeitsliste mit Pflichtspalten und Öffnungsmodus",
        "parameters": [{"$ref": "#/components/parameters/Page"}, {"$ref": "#/components/parameters/PageSize"}, {"name": "search", "in": "query", "schema": {"type": "string", "maxLength": 200}}],
        "responses": {"200": {"description": "Policy-filtered page; ETag is for read cache validation only", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorklistPage"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/clinic/v1/worklist/filters": {
