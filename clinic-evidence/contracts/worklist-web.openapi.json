        "responses": {"200": {"description": "At most 20 own filters", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "properties": {"items": {"type": "array", "maxItems": 20, "items": {"$ref": "#/components/schemas/SavedFilterSummary"}}}, "required": ["items"]}}}}, "401": {"$ref": "#/components/responses/Problem"}}
      }
