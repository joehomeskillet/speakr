{
  "openapi": "3.0.3",
  "info": {
    "title": "Speakr clinic web audio extension contracts",
    "version": "0.1.0-proposal",
    "description": "Additive own-platform web contract for PAR-REC-001, PAR-LIVE-001 and PAR-COR-002 (R-039, R-042). Consumer routes are proposed, not registered. Manufacturer interfaces and the original BT-REC-001, BT-LIVE-001, BT-COR-002 evidence remain unresolved."
  },
  "x-clinic-mode-only": true,
  "x-open-web-gaps": "All 13 existing web parity gaps remain open; this proposal provides only permitted web targets.",
  "x-existing-operations": [
    {"group": "audio-api", "source": "clinic-api.openapi.json", "method": "POST", "path": "/api/clinic/v1/ingests", "operationId": "beginIngest", "schema": "BeginIngest", "handler": "src.clinic.ingest.IngestService.store_original"},
    {"group": "audio-api", "source": "clinic-api.openapi.json", "method": "PUT", "path": "/api/clinic/v1/ingests/{ingest_id}/chunks/{sequence}", "operationId": "putChunk", "schema": "ChunkDigest", "handler": "src.clinic.recorder_chunks.ChunkSession.accept"},
    {"group": "audio-api", "source": "clinic-api.openapi.json", "method": "POST", "path": "/api/clinic/v1/ingests/{ingest_id}/finalize", "operationId": "finalizeIngest", "schema": "FinalizeIngest", "handler": "src.clinic.recorder_chunks.ChunkSession.finalize"},
    {"group": "dictation-properties-api", "source": "clinic-api.openapi.json", "method": "GET", "path": "/api/clinic/v1/dictations/{dictation_id}", "operationId": "getDictation", "schema": "Dictation", "handler": "src.clinic.models.ClinicDictation"},
    {"group": "correction-api", "source": "clinic-api.openapi.json", "method": "POST", "path": "/api/clinic/v1/dictations/{dictation_id}/revisions", "operationId": "saveRevision", "schema": "SaveRevision", "handler": "src.clinic.revisions.add_human_revision"},
    {"group": "correction-api", "source": "clinic-api.openapi.json", "method": "GET", "path": "/api/clinic/v1/dictations/{dictation_id}/revisions/{revision_id}", "operationId": "getRevisionContent", "schema": "TranscriptContent", "handler": "src.clinic.revisions.current_revision"},
    {"group": "audio-api", "source": "clinic-api.openapi.json", "method": "GET", "path": "/api/clinic/v1/dictations/{dictation_id}/audio/{original_version_id}", "operationId": "streamAudio", "schema": "MediaSegment", "handler": "src.clinic.dictation_playback.playable_locator"},
    {"group": "audio-api", "source": "parity-api.openapi.json", "method": "POST", "path": "/parity/commands", "operationId": "executeParityCommand", "command": "edit_audio", "schema": "EditAudio", "handler": "src.clinic.audio_revisions.apply_insert/apply_overwrite/apply_trim"},
    {"group": "audio-api", "source": "parity-api.openapi.json", "method": "POST", "path": "/parity/commands", "operationId": "executeParityCommand", "command": "undo_audio", "schema": "UndoAudio", "handler": "src.clinic.audio_revisions.undo/redo"},
    {"group": "live-api", "source": "parity-api.openapi.json", "method": "POST", "path": "/parity/commands", "operationId": "executeParityCommand", "command": "start_live_session", "schema": "StartLiveSession", "handler": "src.clinic.live_session.start"},
    {"group": "live-api", "source": "parity-api.openapi.json", "method": "POST", "path": "/parity/commands", "operationId": "executeParityCommand", "command": "stop_live_session", "schema": "StopLiveSession", "handler": "src.clinic.live_session.end"},
    {"group": "correction-api", "source": "parity-api.openapi.json", "method": "POST", "path": "/parity/commands", "operationId": "executeParityCommand", "command": "save_index", "schema": "SaveIndex", "handler": "src.clinic.correction.save_state"}
  ],
  "x-compatibility": {
    "browser": "Existing clinic browserSession, action-specific object permissions, active admin full read and audited access, live holder and edit lease checks. No device/native dictation endpoint.",
    "writes": "X-CSRFToken required; If-Match current opaque aggregate ETag (absent 428, stale 412); Idempotency-Key UUID scoped by actor + operation + aggregate with durable request hash. Identical retries return the first receipt; changed payload under the same key is 409. Commit state and audit atomically; failed attempts do not advance revisions.",
    "text_audio": "On EVERY saveRevision automatically reconcile unchanged word timestamps, take neighbouring times for changed spans, and leave newly typed words without an audio anchor. The correction consumer must implement this hook and enforce open configured review markers blocking final release.",
    "permissions": "Ordinary typists access their assigned dictations only. Active admins may access any audio/transcript directly with audit. Admins and typist-pool leads may assign unassigned dictations to any author with audit; field-specific denies still apply.",
    "local_only": "ASR and TTS run on declared local backends. No cloud speech endpoint or persistent browser audio cache."
  },
  "security": [{"browserSession": []}],
  "paths": {
    "/api/clinic/v1/dictations/{dictation_id}/properties": {
      "parameters": [{"$ref": "#/components/parameters/DictationId"}],
      "get": {"operationId": "readWebDictationProperties", "x-handler": "src.clinic.models.ClinicDictation", "x-consumer": "w094-dictation-properties-api", "x-permission": "dictation.read per object; admin audited", "responses": {"200": {"description": "Current editable properties and opaque ETag", "headers": {"ETag": {"schema": {"type": "string", "maxLength": 128}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Properties"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}}},
      "patch": {"operationId": "changeWebDictationProperties", "x-handler": "src.clinic.metadata_changes.plan_changes", "x-consumer": "w094-dictation-properties-api", "x-permission": "per-field rename/priority/reassign; unassigned list limited to admin/pool lead; audit", "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"$ref": "#/components/parameters/IfMatch"}, {"$ref": "#/components/parameters/Idempotency"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PropertiesPatch"}}}}, "responses": {"200": {"description": "Atomic update or identical retry; new ETag", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Properties"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "412": {"$ref": "#/components/responses/Problem"}, "428": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/clinic/v1/dictations/{dictation_id}/audio-revisions/current": {
      "parameters": [{"$ref": "#/components/parameters/DictationId"}],
      "get": {"operationId": "readWebAudioRevision", "x-handler": "src.clinic.audio_revisions.current_audio_revision/get_revision_edl", "x-consumer": "w093-audio-api", "x-permission": "dictation.audio.play per object; admin audited; managed session", "responses": {"200": {"description": "Bounded current non-destructive edit decision list", "headers": {"ETag": {"schema": {"type": "string", "maxLength": 128}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AudioRevisionView"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/clinic/v1/dictations/{dictation_id}/bundle": {
      "parameters": [{"$ref": "#/components/parameters/DictationId"}],
      "get": {"operationId": "downloadWebDictationBundle", "x-handler": "src.clinic.sdict_bundle.build_bundle", "x-consumer": "w095-bundle-api", "x-permission": "dictation.export per object; admin audited; exclude unauthorized content", "responses": {"200": {"description": "Private ZIP; maximum 200 entries, 256 MiB per entry, 512 MiB total uncompressed, ratio 100; no-store and attachment disposition", "headers": {"Cache-Control": {"schema": {"type": "string", "enum": ["no-store"]}}, "Content-Disposition": {"schema": {"type": "string", "maxLength": 255}}}, "content": {"application/zip": {"schema": {"type": "string", "format": "binary", "maxLength": 536870912}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "413": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/clinic/v1/bundles/inspect": {
      "post": {"operationId": "inspectWebDictationBundle", "x-handler": "src.clinic.sdict_bundle.read_bundle", "x-consumer": "w095-bundle-api", "x-permission": "clinic.import; no persisted import or automatic assignment", "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"$ref": "#/components/parameters/Idempotency"}], "requestBody": {"required": true, "content": {"application/zip": {"schema": {"type": "string", "format": "binary", "maxLength": 536870912}}}}, "responses": {"200": {"description": "Validated only; identical request replay is identical", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BundleInspection"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "413": {"$ref": "#/components/responses/Problem"}, "415": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/clinic/v1/dictations/{dictation_id}/live-session": {
      "parameters": [{"$ref": "#/components/parameters/DictationId"}],
      "get": {"operationId": "readWebLiveSession", "x-handler": "src.clinic.live_session.active_session", "x-consumer": "w096-live-api", "x-permission": "dictation.live.read per object, holder-only receipt detail", "responses": {"200": {"description": "Current session state and latest acknowledged offset", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LiveReceipt"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/clinic/v1/dictations/{dictation_id}/live-session/recover": {
      "parameters": [{"$ref": "#/components/parameters/DictationId"}],
      "post": {"operationId": "recoverWebLiveSession", "x-handler": "src.clinic.live_session.recover", "x-consumer": "w096-live-api", "x-permission": "current live holder only; no takeover of another active holder", "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"$ref": "#/components/parameters/IfMatch"}, {"$ref": "#/components/parameters/Idempotency"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecoverLive"}}}}, "responses": {"200": {"description": "Same recovered holder and last acknowledged offset on retry", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LiveReceipt"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "412": {"$ref": "#/components/responses/Problem"}, "423": {"$ref": "#/components/responses/Problem"}, "428": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/clinic/v1/dictations/{dictation_id}/live-session/{session_id}/receipts": {
      "parameters": [{"$ref": "#/components/parameters/DictationId"}, {"$ref": "#/components/parameters/SessionId"}],
      "post": {"operationId": "acknowledgeWebLiveReceipt", "x-handler": "src.clinic.live_session.acknowledge", "x-consumer": "w096-live-api", "x-permission": "live holder only; reject expired or replaced holder", "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"$ref": "#/components/parameters/IfMatch"}, {"$ref": "#/components/parameters/Idempotency"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AcknowledgeLive"}}}}, "responses": {"200": {"description": "Monotonic receipt; identical seq and payload replay is a no-op", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LiveReceipt"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "412": {"$ref": "#/components/responses/Problem"}, "423": {"$ref": "#/components/responses/Problem"}, "428": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/clinic/v1/dictations/{dictation_id}/revisions/{revision_id}/audio-links": {
      "parameters": [{"$ref": "#/components/parameters/DictationId"}, {"$ref": "#/components/parameters/RevisionId"}],
      "get": {"operationId": "readWebCorrectionLinks", "x-handler": "src.clinic.correction.effective_links", "x-consumer": "w100-correction-api", "x-permission": "dictation.transcript.read per object; admin audited", "parameters": [{"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0, "maximum": 1000000}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 100}}], "responses": {"200": {"description": "Links effective for requested exact transcript revision", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AudioLinkPage"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}}},
      "post": {"operationId": "setWebManualAudioLink", "x-handler": "src.clinic.correction.set_manual_link", "x-consumer": "w100-correction-api", "x-permission": "dictation.correction.edit per object with edit lease and live holder guard", "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"$ref": "#/components/parameters/IfMatch"}, {"$ref": "#/components/parameters/Idempotency"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ManualAudioLink"}}}}, "responses": {"201": {"description": "Manual override persisted with audit; identical retry returns same link", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AudioLink"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "412": {"$ref": "#/components/responses/Problem"}, "423": {"$ref": "#/components/responses/Problem"}, "428": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/clinic/v1/dictations/{dictation_id}/tts/preview": {
      "parameters": [{"$ref": "#/components/parameters/DictationId"}],
      "post": {"operationId": "previewWebLocalSpeech", "x-handler": "src.clinic.local_tts.synthesize", "x-consumer": "w097-tts-api", "x-permission": "dictation.audio.play and transcript.read per object; locally verified voice only", "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"$ref": "#/components/parameters/IfMatch"}, {"$ref": "#/components/parameters/Idempotency"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TtsPreview"}}}}, "responses": {"200": {"description": "Ephemeral local audio, at most 8 MiB, no training or voice-profile persistence", "headers": {"Cache-Control": {"schema": {"type": "string", "enum": ["no-store"]}}, "X-Voice-Id": {"schema": {"type": "string", "maxLength": 128}}}, "content": {"audio/wav": {"schema": {"type": "string", "format": "binary", "maxLength": 8388608}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "412": {"$ref": "#/components/responses/Problem"}, "413": {"$ref": "#/components/responses/Problem"}, "428": {"$ref": "#/components/responses/Problem"}, "503": {"description": "CAPABILITY_UNAVAILABLE or local engine failure; no remote fallback", "content": {"application/problem+json": {"schema": {"$ref": "../../clinic-spec/contracts/clinic-api.openapi.json#/components/schemas/Problem"}}}}}}
    }
  },
  "components": {
    "securitySchemes": {"browserSession": {"$ref": "../../clinic-spec/contracts/clinic-api.openapi.json#/components/securitySchemes/browserSession"}},
    "parameters": {
      "DictationId": {"name": "dictation_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "RevisionId": {"name": "revision_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "SessionId": {"name": "session_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "Csrf": {"name": "X-CSRFToken", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 512}},
      "IfMatch": {"$ref": "../../clinic-spec/contracts/clinic-api.openapi.json#/components/parameters/IfMatch"},
      "Idempotency": {"$ref": "../../clinic-spec/contracts/clinic-api.openapi.json#/components/parameters/Idempotency"}
    },
    "responses": {"Problem": {"description": "Unauthorized 401, forbidden 403, conflict or changed idempotency payload 409, stale 412, locked 423, missing If-Match 428, size limit 413 or unavailable local capability 503. No state change on failure.", "content": {"application/problem+json": {"schema": {"$ref": "../../clinic-spec/contracts/clinic-api.openapi.json#/components/schemas/Problem"}}}}},
    "schemas": {
      "Properties": {"type": "object", "additionalProperties": false, "required": ["dictation", "title", "priority"], "properties": {"dictation": {"$ref": "../../clinic-spec/contracts/clinic-api.openapi.json#/components/schemas/Dictation"}, "title": {"type": "string", "minLength": 1, "maxLength": 200}, "priority": {"type": "integer", "enum": [0, 1, 128]}, "deadline_date": {"type": "string", "nullable": true, "format": "date"}, "deadline_time": {"type": "string", "nullable": true, "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"}, "assignee_user_id": {"type": "integer", "nullable": true, "minimum": 1}}},
      "PropertiesPatch": {"type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 7, "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 200}, "priority": {"type": "integer", "enum": [0, 1, 128]}, "deadline_date": {"type": "string", "nullable": true, "format": "date"}, "deadline_time": {"type": "string", "nullable": true, "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"}, "author_user_id": {"type": "integer", "minimum": 1}, "assignee_user_id": {"type": "integer", "nullable": true, "minimum": 1}, "pool_id": {"type": "string", "format": "uuid"}}, "description": "Partial typed changes; deadline_time requires deadline_date in this patch or current state, date alone defaults to 23:59:59 Europe/Zurich. Each field enforces its own action-specific permission and audit."},
      "AudioRevisionView": {"type": "object", "additionalProperties": false, "required": ["revision_id", "segments"], "properties": {"revision_id": {"type": "string", "format": "uuid"}, "segments": {"type": "array", "maxItems": 5000, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "start_ms", "end_ms"], "properties": {"source_id": {"type": "string", "format": "uuid"}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 0}}}}}},
      "BundleInspection": {"type": "object", "additionalProperties": false, "required": ["valid", "entries", "uncompressed_bytes"], "properties": {"valid": {"type": "boolean", "enum": [true]}, "entries": {"type": "integer", "minimum": 0, "maximum": 200}, "uncompressed_bytes": {"type": "integer", "minimum": 0, "maximum": 536870912}}},
      "RecoverLive": {"type": "object", "additionalProperties": false, "properties": {"client_id": {"type": "string", "minLength": 1, "maxLength": 128}}},
      "AcknowledgeLive": {"type": "object", "additionalProperties": false, "required": ["seq", "audio_offset_ms"], "properties": {"seq": {"type": "integer", "minimum": 0}, "audio_offset_ms": {"type": "integer", "minimum": 0}, "text_ref": {"type": "string", "nullable": true, "maxLength": 128}}, "description": "Sequence and offset never regress; identical sequence with a different payload fails 409. Text reference must bind to the same dictation."},
      "LiveReceipt": {"type": "object", "additionalProperties": false, "required": ["session_id", "state", "seq", "audio_offset_ms"], "properties": {"session_id": {"type": "string", "format": "uuid"}, "state": {"type": "string", "enum": ["RECORDING", "PAUSED", "ENDED"]}, "seq": {"type": "integer", "minimum": 0}, "audio_offset_ms": {"type": "integer", "minimum": 0}, "text_ref": {"type": "string", "nullable": true, "maxLength": 128}}},
      "AudioLink": {"type": "object", "additionalProperties": false, "required": ["origin", "text_start", "text_end", "audio_start_ms", "audio_end_ms"], "properties": {"origin": {"type": "string", "enum": ["AUTO", "MANUAL"]}, "text_start": {"type": "integer", "minimum": 0}, "text_end": {"type": "integer", "minimum": 1}, "audio_start_ms": {"type": "integer", "minimum": 0}, "audio_end_ms": {"type": "integer", "minimum": 0}}},
      "ManualAudioLink": {"type": "object", "additionalProperties": false, "required": ["text_start", "text_end", "audio_start_ms", "audio_end_ms"], "properties": {"text_start": {"type": "integer", "minimum": 0}, "text_end": {"type": "integer", "minimum": 1}, "audio_start_ms": {"type": "integer", "minimum": 0}, "audio_end_ms": {"type": "integer", "minimum": 0}}, "description": "Nonempty text interval and nondecreasing audio interval. Current transcript revision and current audio revision only; release bound to reviewed versions."},
      "AudioLinkPage": {"type": "object", "additionalProperties": false, "required": ["links", "next_offset"], "properties": {"links": {"type": "array", "maxItems": 200, "items": {"$ref": "#/components/schemas/AudioLink"}}, "next_offset": {"type": "integer", "nullable": true, "minimum": 0}}},
      "TtsPreview": {"type": "object", "additionalProperties": false, "required": ["transcript_revision_id", "text_version"], "properties": {"transcript_revision_id": {"type": "string", "format": "uuid"}, "text_version": {"type": "integer", "minimum": 0}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}, "cursor": {"type": "integer", "minimum": 0}, "pronunciation": {"type": "string", "minLength": 1, "maxLength": 2000}, "requested_voice": {"type": "string", "minLength": 1, "maxLength": 128}}, "description": "Selection or pronunciation up to 2000 characters of exact current canonical text. Reject changed version, unchecked browser backend, or missing local engine. No supplied arbitrary patient text."}
    }
  }
}
