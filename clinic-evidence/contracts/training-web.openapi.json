{
  "openapi": "3.1.0",
  "info": {
    "title": "Speakr clinic training and pronunciation extension",
    "version": "0.1.0-proposal",
    "description": "Additive own-platform contracts, not deployed endpoints. Training and pronunciation effectiveness require independent local engine evidence. Manufacturer interfaces and original BT oracles remain unresolved."
  },
  "servers": [{"url": "/api/clinic/v1"}],
  "security": [{"ClinicSession": []}],
  "x-implementation-status": "specified_not_implemented",
  "x-requirements": ["PAR-ASR-004", "PAR-ASR-005", "PAR-VOC-007", "R-039", "R-042"],
  "x-original-tests": ["BT-ASR-004", "BT-ASR-005", "BT-VOC-007"],
  "x-existing-mappings": [
    {"method": "POST", "path": "/api/clinic/v1/parity/commands", "operationId": "executeParityCommand", "handler": "executeParityCommand", "command": "request_adaptation", "request_schema": "RequestAdaptation", "permission": "clinic.asr.adapt", "consumer": "w105-training-api", "scope": "pronunciation_training, language_adaptation, acoustic_adaptation"},
    {"method": "POST", "path": "/api/clinic/v1/parity/commands", "operationId": "executeParityCommand", "handler": "executeParityCommand", "command": "save_profile", "request_schema": "SaveProfile", "permission": "clinic.profile.manage", "consumer": "w105-training-api"},
    {"method": "POST", "path": "/api/clinic/v1/parity/commands", "operationId": "executeParityCommand", "handler": "executeParityCommand", "command": "propose_vocabulary_change", "request_schema": "ProposeVocabularyChange", "permission": "clinic.vocabulary.propose", "consumer": "w264-pronunciation-api"},
    {"method": "POST", "path": "/api/clinic/v1/parity/commands", "operationId": "executeParityCommand", "handler": "executeParityCommand", "command": "review_resource_change", "request_schema": "ReviewResourceChange", "permission": "clinic.vocabulary.review", "consumer": "w264-pronunciation-api"}
  ],
  "x-contract-semantics": {
    "authentication": "Browser session and CLINIC_MODE route policy; default deny unknown routes. Never trust user_id, pool_ids, or scope_id without a current object permission check. No patient data in URLs, logs or cache.",
    "reads": "Authorized own resources or explicitly granted scope only; verify each pool membership. Return Cache-Control: no-store. Reads have no CSRF requirement.",
    "writes": "Validate X-CSRF-Token, Idempotency-Key, request_id, expected revision and object permissions before any effect. A revision mismatch returns 409 REVISION_CONFLICT without mutation. Same authenticated actor, endpoint, key and identical request replay the identical committed response. A changed request or actor/key collision returns 409 IDEMPOTENCY_CONFLICT. Failures and uncertain queue submissions cannot create a duplicate job on retry; reconcile the original request_id before resubmission. Return Cache-Control: no-store.",
    "adaptation": "Existing request_adaptation is the only training command. Require explicit reviewed and selected corpus, opt-in where applicable, exact text/audio alignment for acoustic mode, and a trusted local capability probe. Missing capability returns 422 CAPABILITY_UNAVAILABLE without a job. Training uses ProcessingJob/JobQueue, separate from recognition. Insufficient engine-specific data means waiting_data, outside configured windows means waiting_window, never succeeded. Success requires an evaluated model artifact; prompts, hints, TTS and saving a correction do not prove learning.",
    "limits": "JSON writes at most 8192 bytes; JSON reads at most 65536 bytes; reject overflow with 413. Rate limit writes (429); no external ASR or training endpoints."
  },
  "paths": {
    "/training/users/{user_id}/status": {
      "parameters": [{"$ref": "#/components/parameters/UserId"}],
      "get": {
        "operationId": "getClinicTrainingStatus",
        "summary": "Trainingsstatus anzeigen",
        "x-service-entrypoints": ["src.clinic.asr_profiles.asr_status", "src.clinic.asr_capabilities.AsrCapabilityRegistry.check"],
        "x-consumer": "w105-training-api",
        "responses": {"200": {"description": "Authorized status; history is distinct from engine capability", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TrainingStatus"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/training/users/{user_id}/policy": {
      "parameters": [{"$ref": "#/components/parameters/UserId"}],
      "get": {
        "operationId": "getClinicTrainingPolicy",
        "summary": "Optimierungszeitfenster und Mindestmenge lesen",
        "x-consumer": "w105-training-api",
        "responses": {"200": {"description": "Authorized versioned policy", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TrainingPolicy"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}}
      },
      "put": {
        "operationId": "putClinicTrainingPolicy",
        "summary": "Optimierungszeitfenster und Mindestmenge speichern",
        "x-required-permission": "clinic.asr.adapt on target user/profile",
        "x-consumer": "w105-training-api",
        "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"$ref": "#/components/parameters/Idempotency"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TrainingPolicyWrite"}}}},
        "responses": {"200": {"description": "Committed policy, including new revision", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TrainingPolicy"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "413": {"$ref": "#/components/responses/Problem"}, "429": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/pronunciations/users/{user_id}/hints": {
      "parameters": [{"$ref": "#/components/parameters/UserId"}],
      "get": {
        "operationId": "listClinicPronunciationHints",
        "summary": "Wirksame Aussprachehinweise anzeigen",
        "x-service-entrypoint": "src.clinic.vocabulary.get_effective_pronunciation_hints",
        "x-consumer": "w264-pronunciation-api",
        "parameters": [{"name": "pool_id", "in": "query", "schema": {"type": "array", "maxItems": 20, "items": {"type": "string", "format": "uuid"}}, "style": "form", "explode": true}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}, {"name": "cursor", "in": "query", "schema": {"type": "string", "minLength": 1, "maxLength": 128}}],
        "responses": {"200": {"description": "Only effective hints in authorized scopes", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PronunciationList"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/pronunciations/commands": {
      "post": {
        "operationId": "saveClinicPronunciationHint",
        "summary": "Aussprachehinweis versioniert speichern",
        "x-service-entrypoint": "src.clinic.vocabulary.add_pronunciation_hint",
        "x-required-permission": "clinic.vocabulary.propose on target user or author pool",
        "x-consumer": "w264-pronunciation-api",
        "description": "Expected revision token comes from the read result and is checked against the row's existing updated_at under a serialized write; 'new' requires absence. This is a stored hint, never proof the ASR engine has applied phonetic training.",
        "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"$ref": "#/components/parameters/Idempotency"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PronunciationWrite"}}}},
        "responses": {"200": {"description": "Hint persisted; effect on recognition not claimed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PronunciationResult"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "413": {"$ref": "#/components/responses/Problem"}, "429": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"ClinicSession": {"type": "apiKey", "in": "cookie", "name": "clinic_session"}},
    "parameters": {
      "UserId": {"name": "user_id", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
      "Csrf": {"name": "X-CSRF-Token", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}},
      "Idempotency": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 128}}
    },
    "responses": {"Problem": {"description": "403 forbidden/CSRF, 409 stale or idempotency conflict, 503 dependency failure; other codes as in the parity API", "content": {"application/problem+json": {"schema": {"$ref": "../../clinic-spec/contracts/parity-api.openapi.json#/components/schemas/Problem"}}}}},
    "schemas": {
      "TrainingStatus": {"type": "object", "additionalProperties": false, "required": ["profile_configured", "profile_version", "training_proven", "training_runs", "adaptation_state", "capability"], "properties": {
        "profile_configured": {"type": "boolean"}, "profile_version": {"type": ["integer", "null"], "minimum": 1}, "training_proven": {"type": "boolean"}, "training_runs": {"type": "integer", "minimum": 0}, "last_training_at": {"type": ["string", "null"], "format": "date-time"},
        "adaptation_state": {"enum": ["not_requested", "waiting_data", "waiting_window", "queued", "running", "succeeded", "failed", "capability_unavailable"]}, "capability": {"enum": ["runtime_proven", "CAPABILITY_UNAVAILABLE"]}
      }},
      "TrainingPolicy": {"type": "object", "additionalProperties": false, "required": ["revision", "timezone", "minimum_audio_seconds", "windows"], "properties": {
        "revision": {"type": "integer", "minimum": 1}, "timezone": {"const": "Europe/Zurich"}, "minimum_audio_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}, "windows": {"type": "array", "maxItems": 21, "items": {"$ref": "#/components/schemas/TrainingWindow"}}
      }},
      "TrainingWindow": {"type": "object", "additionalProperties": false, "required": ["weekday", "start_local", "end_local"], "properties": {
        "weekday": {"type": "integer", "minimum": 1, "maximum": 7}, "start_local": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}, "end_local": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}
      }},
      "TrainingPolicyWrite": {"type": "object", "additionalProperties": false, "required": ["request_id", "expected_revision", "minimum_audio_seconds", "windows"], "properties": {
        "request_id": {"type": "string", "format": "uuid"}, "expected_revision": {"type": "integer", "minimum": 0}, "minimum_audio_seconds": {"$ref": "#/components/schemas/TrainingPolicy/properties/minimum_audio_seconds"}, "windows": {"$ref": "#/components/schemas/TrainingPolicy/properties/windows"}
      }},
      "PronunciationHint": {"type": "object", "additionalProperties": false, "required": ["id", "written_form", "phonetic_hint", "source", "revision_token"], "properties": {
        "id": {"type": "string", "format": "uuid"}, "written_form": {"type": "string", "minLength": 1, "maxLength": 255}, "phonetic_hint": {"type": "string", "minLength": 1, "maxLength": 255}, "sounds_like": {"type": ["string", "null"], "maxLength": 255}, "notes": {"type": ["string", "null"], "maxLength": 1024}, "source": {"type": "string", "minLength": 1, "maxLength": 64}, "revision_token": {"type": "string", "minLength": 1, "maxLength": 128}
      }},
      "PronunciationList": {"type": "object", "additionalProperties": false, "required": ["items", "has_more"], "properties": {
        "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/PronunciationHint"}}, "has_more": {"type": "boolean"}, "next_cursor": {"type": ["string", "null"], "maxLength": 128}
      }},
      "PronunciationWrite": {"type": "object", "additionalProperties": false, "required": ["command", "request_id", "expected_revision_token", "payload"], "properties": {
        "command": {"const": "save_pronunciation_hint"}, "request_id": {"type": "string", "format": "uuid"}, "expected_revision_token": {"type": "string", "minLength": 1, "maxLength": 128}, "payload": {"type": "object", "additionalProperties": false, "required": ["scope_type", "scope_id", "written_form", "phonetic_hint"], "properties": {
          "scope_type": {"enum": ["user", "author_pool"]}, "scope_id": {"type": "string", "minLength": 1, "maxLength": 64}, "written_form": {"type": "string", "minLength": 1, "maxLength": 255}, "phonetic_hint": {"type": "string", "minLength": 1, "maxLength": 255}, "sounds_like": {"type": ["string", "null"], "maxLength": 255}
        }}
      }},
      "PronunciationResult": {"type": "object", "additionalProperties": false, "required": ["request_id", "hint_id", "revision_token", "status"], "properties": {
        "request_id": {"type": "string", "format": "uuid"}, "hint_id": {"type": "string", "format": "uuid"}, "revision_token": {"type": "string", "minLength": 1, "maxLength": 128}, "status": {"const": "committed"}
      }}
    }
  }
}
